  "platforms": [
    "macos",
    "linux",
    "windows"
  ],
  "config": {},
  "modes": [
    {
      "id": "file",
      "label": "As file",
      "default": true
    },
    {
      "id": "zip",
      "label": "As ZIP"
    }
  ]
