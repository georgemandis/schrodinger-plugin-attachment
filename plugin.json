  "author": "georgemandis",
  "type": "native",
  "entry": {
    "macos-arm64": "lib/libschrodinger_plugin_attachment.dylib",
    "linux-x86_64": "lib/libschrodinger_plugin_attachment.so",
    "windows-x86_64": "lib/schrodinger_plugin_attachment.dll"
